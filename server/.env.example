PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/medifund
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medifund?retryWrites=true&w=majority
JWT_SECRET=medifund_super_secret_jwt_key_2026_secure
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
# Optional Cloudinary (default is local disk storage fallback):
# CLOUDINARY_CLOUD_NAME=demo
# CLOUDINARY_API_KEY=123456789
# CLOUDINARY_API_SECRET=abcdef12345
# Cashfree checkout credentials; sandbox is the safe default. Use production only after merchant activation.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
